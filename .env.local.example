# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database URLs — get from Supabase dashboard → Settings → Database
# Pooler (Transaction mode) — used by the app at runtime
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct connection — used by drizzle-kit for migrations only
DATABASE_DIRECT_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres

# Encryption key — 32 random bytes as hex, used to encrypt LinkedIn tokens and AI keys
ENCRYPTION_KEY=your-32-byte-hex-key-here

# AI Providers (optional — users can also supply their own keys per account)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# LinkedIn OAuth — register at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Trigger.dev — background jobs (optional for Phase 1)
TRIGGER_API_KEY=tr_dev_...
TRIGGER_API_URL=https://api.trigger.dev
